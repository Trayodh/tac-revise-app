  <h3 style="color: var(--accent); margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 8px; display: flex; align-items: center; gap: 8px; font-weight: 600;">
    <span>🔹</span> Immunity & Vaccines
  </h3><h4 style="border-left: 3px solid var(--info); padding-left: 8px; margin-top: 20px; margin-bottom: 10px; color: var(--text-primary); font-weight: 600;">High-Yield Formulas & Facts</h4><ul style="margin-left: 20px; list-style-type: disc; margin-bottom: 12px; color: var(--text-secondary);"><li style="margin-bottom: 8px; line-height: 1.6;"><strong style="color: var(--text-primary);">Innate:</strong> non-specific (skin, tears)</li><li style="margin-bottom: 8px; line-height: 1.6;"><strong style="color: var(--text-primary);">Acquired:</strong> specific (B-cells, T-cells)</li><li style="margin-bottom: 8px; line-height: 1.6;"><strong style="color: var(--text-primary);">Active:</strong> body makes antibodies (infection, vaccine)</li><li style="margin-bottom: 8px; line-height: 1.6;"><strong style="color: var(--text-primary);">Passive:</strong> ready-made antibodies (colostrum, anti-venom)</li><li style="margin-bottom: 8px; line-height: 1.6;"><strong style="color: var(--text-primary);">Vaccines:</strong> Live-attenuated (OPV, BCG), Inactivated (Covaxin, Salk), mRNA (Pfizer)</li></ul>
</div>`;

