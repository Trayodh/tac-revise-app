                  subnodes: ["Atomic radius decreases", "Ionization Energy increases", "Electronegativity increases"]
                },
                {
                  title: "Group Trends (T-B)",
                  subnodes: ["Atomic radius increases", "Ionization Energy decreases", "Metallic character increases"]
                }
              ]
            }
          }
        ]
