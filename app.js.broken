                      <th style="padding:6px; border:1px solid var(--border);">Deficiency Disease</th>
                    </tr>
                    <tr>
                      <td style="padding:6px; border:1px solid var(--border);">Vitamin A</td>
                      <td style="padding:6px; border:1px solid var(--border);">Retinol</td>
