    M --> C3[Influences later grammarians]
    M --> C4[Philosophical exposition]
    classDef primary fill:#f9f9f9,stroke:#333,stroke-width:1px;
    classDef secondary fill:#e0e0e0,stroke:#666,stroke-width:1px;
    class P,K,M primary;
