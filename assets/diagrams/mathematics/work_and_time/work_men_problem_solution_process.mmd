graph TD
    A[Start] --> B[Input: Initial men (M0) and total days (D)]
    B --> C[Compute total work = M0 × D (man-days)]
    C --> D[Input: Work done after 5 days (or compute W5 = M0 × 5)]
    D --> E[Remaining work = total work - W5]
    E --> F[Remaining days = D - 5]
    F --> G[Required daily work = Remaining work / Remaining days]
    G --> H[Extra men needed = Required daily work - M0]
    H --> I{Extra men > 0?}
    I -- Yes --> J[Add extra men (value = Extra men)]
    I -- No --> K[No additional workers required]
    J --> L[End]
    K --> L[End]
    classDef startEnd fill:#f9f,stroke:#333,stroke-width:2px;
    class A,L startEnd;