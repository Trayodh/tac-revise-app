graph TD
    Start[Start] --> Input[Input: 20 men, 5 days, ¼ job]
    Input --> ComputeTotalWork[Compute total work = 20 men * 5 days / ¼ = 400 man‑days]
    ComputeTotalWork --> WorkDone[Work done = 20 men * 5 days = 100 man‑days]
    ComputeTotalWork --> RemainingWork[Remaining work = Total - Done = 300 man‑days]
    RemainingWork --> DaysLeft[Days left = 10 - 5 = 5 days]
    RemainingWork --> RequiredRate[Required daily rate = Remaining work / Days left = 60 men]
    RequiredRate --> ExtraWorkers[Additional workers = Required rate - 20 = 40 men]
    ExtraWorkers --> End[Answer: 40 extra men]
    classDef startEnd fill:#f9f,stroke:#333,stroke-width:2px;
