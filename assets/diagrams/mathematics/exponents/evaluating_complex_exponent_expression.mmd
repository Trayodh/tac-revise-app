graph TD
    classDef start fill:#f9f,stroke:#333,stroke-width:2px;
    classDef end fill:#bbf,stroke:#333,stroke-width:2px;
    A[Start: (x*y*x*z)^4 ÷ 2222] --> B[Combine like factors: x*x = x^2]
    B --> C[Rewrite: (x^2*y*z)^4 ÷ 2222]
    C --> D[Apply power of a product: (x^2)^4 * y^4 * z^4 ÷ 2222]
    D --> E[Calculate powers: x^8 * y^4 * z^4 ÷ 2222]
    E --> F[Observe that numerator equals denominator (given condition)]
    F --> G[Cancel identical numerator and denominator]
    G --> H[Result = 1]
    class A start;
    class H end;