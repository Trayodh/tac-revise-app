flowchart TD
    A[Start] --> B[Input: a = 2000, d = 1000, target S = 170000]
    B --> C[Formula: S_n = n/2·(2a + (n‑1)d)]
    C --> D[Form quadratic: d·n^2 + (2a‑d)·n – 2S = 0]
    D --> E[Set A = d, B = (2a‑d), C = –2S]
    E --> F[Discriminant Δ = B² – 4·A·C]
    F --> G[Compute n = (-B + √Δ) / (2·A)]
    G --> H[Round up n to next integer]
    H --> I[Output: required years = n]
    I --> J[End]
    
    classDef startEnd fill:#f9f,stroke:#333,stroke-width:2px;
    classDef process fill:#bbf,stroke:#333,stroke-width:1px;
    class A,J startEnd;
    class B,C,D,E,F,G,H,I process;