graph TD
    A[Parliamentary Session] --> B[Member requests to speak in mother tongue]
    B --> C{Speaker evaluates request}
    C -- Yes --> D[Speaker grants permission]
    C -- No --> E[Request denied]
    D --> F[Member speaks in mother tongue]
    F --> G[Committee business conducted]
    G --> H{Language chosen}
    H -- Hindi --> I[Proceed in Hindi]
    H -- English --> J[Proceed in English]
    I --> K[Minutes recorded]
    J --> K
    K --> L[Minutes prepared in Hindi and English]
    L --> M[Minutes approved]
    classDef speaker fill:#ffdddd,stroke:#c33;
    classDef committee fill:#ddeeff,stroke:#3399cc;
    classDef minutes fill:#ddffdd,stroke:#33aa33;
    class C,D,E speaker;
    class G,H,I,J committee;
    class K,L,M minutes;