graph TD
    A[Start] --> B[Statement P: Introduce the scenario]
    B --> C{5 minutes elapsed?}
    C -- Yes --> D[Statement Q: First action]
    C -- No --> B
    D --> E{10 minutes elapsed?}
    E -- Yes --> F[Statement R: Second action]
    E -- No --> D
    F --> G[Statement S: Concluding action]
    G --> H[End]
    classDef startEnd fill:#f9f,stroke:#333,stroke-width:2px;
    class A,H startEnd;