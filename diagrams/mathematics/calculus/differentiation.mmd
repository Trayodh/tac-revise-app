  root((Differentiation))
    Basic Rules
      ::icon(fas fa-check)
      Power: nx^ n-1
      ::icon(fas fa-check)
      d e^x /dx = e^x
      ::icon(fas fa-check)
      d ln x /dx = 1/x
      ::icon(fas fa-check)
      Constant = 0
    Trig Derivatives
      ::icon(fas fa-check)
      d sinx =cosx
      ::icon(fas fa-check)
      d cosx =-sinx
      ::icon(fas fa-check)
      d tanx =sec²x
      ::icon(fas fa-check)
      d secx =secx·tanx
    Rules
      ::icon(fas fa-check)
      Product Rule: u'v+uv'
      ::icon(fas fa-check)
      Quotient Rule:  u'v-uv' /v²
      ::icon(fas fa-check)
      Chain Rule: f' g ·g'
    Applications
      ::icon(fas fa-check)
      Maxima: f'=0, f''<0
      ::icon(fas fa-check)
      Minima: f'=0, f''>0
      ::icon(fas fa-check)
      Increasing: f'>0
    Trigonometric
      ::icon(fas fa-check)
      sin x → cos x
      ::icon(fas fa-check)
      cos x → -sin x
      ::icon(fas fa-check)
      tan x → sec² x
    Inverse Trig
      ::icon(fas fa-check)
      sin⁻¹x → 1/√ 1-x²
      ::icon(fas fa-check)
      cos⁻¹x → -1/√ 1-x²
      ::icon(fas fa-check)
      tan⁻¹x → 1/ 1+x²
    Exponential
      ::icon(fas fa-check)
      e^x → e^x
      ::icon(fas fa-check)
      a^x → a^x ln a
      ::icon(fas fa-check)
      ln x → 1/x