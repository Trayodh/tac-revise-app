graph TD
    A[Start]:::start
    B[Draft Amendment Bill]:::process
    C[Introduce Bill in Lok Sabha]:::process
    D{Lok Sabha passes?\n(>50% total & >2/3 present)}:::decision
    E[Lok Sabha passes]:::process
    F[Lok Sabha rejects]:::process
    G[Introduce Bill in Rajya Sabha]:::process
    H{Rajya Sabha passes?\n(>50% total & >2/3 present)}:::decision
    I[Rajya Sabha passes]:::process
    J[Rajya Sabha rejects]:::process
    K{State ratification required?}:::decision
    L[Obtain ratification from majority of states]:::process
    M[No ratification needed]:::process
    N[President's Assent]:::process
    O[Amendment becomes part of Constitution]:::end

    A --> B
    B --> C
    C --> D
    D -- Yes --> E
    D -- No --> F
    E --> G
    F --> O
    G --> H
    H -- Yes --> I
    H -- No --> J
    I --> K
    J --> O
    K -- Yes --> L
    K -- No --> M
    L --> N
    M --> N
    N --> O

    classDef start fill:#e0ffe0,stroke:#333,stroke-width:2px;
    classDef end fill:#ffe0e0,stroke:#333,stroke-width:2px;
    classDef process fill:#e0eaff,stroke:#333,stroke-width:2px;
    classDef decision fill:#fff0b3,stroke:#333,stroke-width:2px;

    class A start;
    class O end;
    class D H K decision;
    class B C E G I L M N process;
    class F J process;