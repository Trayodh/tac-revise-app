{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GS Microtopic",
  "type": "object",
  "properties": {
    "id": {"type": "string"},
    "exam": {"type": "array", "items": {"type": "string", "enum": ["NDA","CDS","AFCAT"]}},
    "subject": {"type": "string"},
    "chapter": {"type": "string"},
    "subtopic": {"type": "string"},
    "microtopic": {"type": "string"},
    "notes": {"type": "string"},
    "facts": {"type": "array", "items": {"type": "string"}},
    "diagrams": {"type": "array", "items": {"type": "string"}},
    "maps": {"type": "array", "items": {"type": "string"}},
    "timelines": {"type": "array", "items": {"type": "string"}},
    "flowcharts": {"type": "array", "items": {"type": "string"}},
    "memoryTechniques": {"type": "array", "items": {"type": "string"}},
    "pyqAnalysis": {"type": "string"},
    "commonMistakes": {"type": "array", "items": {"type": "string"}},
    "revisionMaterial": {"type": "string"},
    "practiceQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {"type": "string"},
          "options": {"type": "array", "items": {"type": "string"}},
          "answer": {"type": "string"},
          "explanation": {"type": "string"}
        },
        "required": ["question","options","answer","explanation"]
      }
    }
  },
  "required": ["id","exam","subject","chapter","microtopic","notes"]
}
